# Build context = backend/. Keep it small: the kernel image only needs
# pyproject.toml, uv.lock, kernel/, alembic/kernel/, and docker/. Everything
# below is either huge, irrelevant to the kernel, or deliberately excluded
# (valuz_agent — the HOST package — must NOT enter the boundary-clean kernel
# image).
.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Host application + tests — not part of the kernel image.
valuz_agent/
plugins/
tests/
scripts/

# Local data / scratch / VCS.
*.db
*.db-wal
*.db-shm
.git/
.gitignore
**/.DS_Store
