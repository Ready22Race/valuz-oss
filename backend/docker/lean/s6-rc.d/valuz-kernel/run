#!/command/with-contenv bash
# Valuz kernel s6 service (lean image). Non-root (uid 1000) via s6-setuidgid.
#
# GATED START. This service ships DOWN (sibling `down` file) so AGS snapshot-start
# never captures the kernel running with the template's placeholder env. After the
# snapshot resumes, the host writes the per-user env into the s6 container-
# environment and `s6-svc -u`s this service (via the valuz-apply-env helper) — so
# by the time this run script executes, `with-contenv` above has exported the
# correct per-user env (KERNEL_STORE / VALUZ_DATA_API_* / KERNEL_AUTH_TOKEN). The
# kernel therefore starts exactly once, already configured. The AGS tool readiness
# probe is on envd (:49983), so the instance reaches RUNNING while this stays down.
#
# PERSISTENCE. db + logs live on the per-owner COS mount at ~/.valuz-kernel, and
# ~/.claude / ~/.codex are likewise per-owner COS mounts (all declared in the AGS
# provision). So they survive sandbox recreation, and the runtime uses its NATIVE
# home paths — NO CLAUDE_CONFIG_DIR / CODEX_HOME redirect, NO owner-dir glob.
set -eu

export PYTHONPATH=/app/kernel
export HOME=/home/user
cd /app

# Kernel SQLite + logs on the COS mount (diagnosability + local-store durability).
KDIR=/home/user/.valuz-kernel
mkdir -p "${KDIR}" 2>/dev/null || true
chown user:user "${KDIR}" 2>/dev/null || true
export DATABASE_URL="sqlite+aiosqlite:///${KDIR}/kernel.db"

# Boot marker on the mount (best-effort) so the env/store choice is visible
# host-side even if the kernel fails to start.
echo "boot $(date -u 2>/dev/null || true): DATABASE_URL=${DATABASE_URL} KERNEL_STORE=${KERNEL_STORE:-<unset>}" \
    >>"${KDIR}/boot.log" 2>/dev/null || true
chown user:user "${KDIR}/boot.log" 2>/dev/null || true

s6-setuidgid user /app/.venv/bin/python -m alembic -c alembic/kernel/alembic.ini upgrade head
exec s6-setuidgid user sh -c \
    "exec /app/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port ${KERNEL_PORT:-8000} --log-level ${LOG_LEVEL:-info} >> '${KDIR}/serve.log' 2>&1"
