#!/command/with-contenv bash
# Valuz kernel s6 service (lean image). Non-root (uid 1000) via s6-setuidgid.
#
# GATED START. This service ships DOWN (sibling `down` file) so AGS snapshot-start
# never captures the kernel running with the template's placeholder env. After the
# snapshot resumes, the host (AgsSandboxBackend.apply_env, over envd) writes the
# per-user env to ${VALUZ_ENV_FILE} and then `s6-svc -r`s this service — so by the
# time this run script executes, sourcing that file below gives us the correct
# per-user env (KERNEL_STORE / VALUZ_DATA_API_* / KERNEL_AUTH_TOKEN). The kernel
# starts exactly once, already configured. The AGS tool readiness probe is on
# envd (:49983), so the instance reaches RUNNING while this stays down.
#
# Why a sourced file, not the s6 container_environment: this image sets
# S6_KEEP_ENV=1, so `with-contenv` keeps the inherited process env and does NOT
# read /run/s6/container_environment — writing env there would have no effect.
#
# DB ON LOCAL DISK (perf). Measured: sqlite's FIRST access over the COS FUSE
# mount costs ~1.4s (WAL setup + page reads) and every instance's mount is fresh,
# so a COS-backed kernel.db taxed every cold bootstrap ~2.5-3s (alembic incl.).
# Under KERNEL_STORE=remote — the only cloud mode — PG is authoritative and the
# sqlite db is just a write-through buffer, so it lives on LOCAL disk
# (${VALUZ_KERNEL_DB_DIR:-/app/data}) and is deliberately ephemeral. Set
# VALUZ_KERNEL_DB_DIR=/home/user/.valuz-kernel to put it back on the COS mount
# (e.g. a KERNEL_STORE=local deployment that needs db durability).
#
# LOGS ON COS (diagnosability). boot.log + serve.log go to the per-owner COS
# mount at ~/.valuz-kernel so a dead sandbox can still be post-mortemed.
# ~/.claude / ~/.codex are likewise per-owner COS mounts (declared in the AGS
# provision) — the runtime uses its NATIVE home paths, no env redirects.
#
# SINGLE PROCESS (perf). kernel-launch.py runs the alembic migration via the API
# and then uvicorn.run() in ONE interpreter — the old two-process boot imported
# sqlalchemy/alembic twice (~0.5-1s wasted).
set -eu

# Per-user env applied post-snapshot by the host (see apply_env). Sourced with
# auto-export so every KEY reaches the kernel process.
VALUZ_ENV_FILE="${VALUZ_ENV_FILE:-/run/valuz/env}"
if [ -f "${VALUZ_ENV_FILE}" ]; then
    set -a
    # shellcheck disable=SC1090
    . "${VALUZ_ENV_FILE}"
    set +a
fi

export PYTHONPATH=/app/kernel
export HOME=/home/user
cd /app

# Kernel SQLite on local disk (see header); logs on the COS mount.
DBDIR="${VALUZ_KERNEL_DB_DIR:-/app/data}"
KDIR=/home/user/.valuz-kernel
mkdir -p "${DBDIR}" "${KDIR}" 2>/dev/null || true
chown user:user "${DBDIR}" "${KDIR}" 2>/dev/null || true
export DATABASE_URL="sqlite+aiosqlite:///${DBDIR}/kernel.db"

# Boot marker on the mount (best-effort) so the env/store choice is visible
# host-side even if the kernel fails to start.
echo "boot $(date -u 2>/dev/null || true): DATABASE_URL=${DATABASE_URL} KERNEL_STORE=${KERNEL_STORE:-<unset>}" \
    >>"${KDIR}/boot.log" 2>/dev/null || true
chown user:user "${KDIR}/boot.log" 2>/dev/null || true

exec s6-setuidgid user sh -c \
    "exec /app/.venv/bin/python /app/kernel-launch.py >> '${KDIR}/serve.log' 2>&1"
