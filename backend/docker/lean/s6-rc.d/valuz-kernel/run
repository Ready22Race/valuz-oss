#!/command/with-contenv bash
# Valuz kernel s6 service (lean image). Non-root (uid 1000) via s6-setuidgid.
#
# FEASIBILITY TEST (COS-backed db + logs): instead of the container-local,
# ephemeral /app/data, put the kernel's SQLite + serve log on the per-owner COS
# mount (/data/valuz_data/<owner>/.valuz-kernel/), which is persistent across
# sandbox restarts. This exercises whether SQLite tolerates the COS FUSE mount
# (POSIX file locking is the known risk). Falls back to /app/data if the mount
# isn't present/writable. A boot marker is written so the choice + any failure
# is visible host-side via the same COS bucket.
set -eu

export PYTHONPATH=/app/kernel
export HOME=/home/user
cd /app

# The per-owner COS prefix is mounted at /data/valuz_data/<owner> (32-hex dir);
# workspace/ and valuz_config/ start with non-hex letters so the glob skips them.
OWNER_DIR="$(ls -d /data/valuz_data/[0-9a-f]*/ 2>/dev/null | head -1 || true)"
KDIR=""
if [ -n "${OWNER_DIR}" ]; then
    KDIR="${OWNER_DIR%/}/.valuz-kernel"
    CCDIR="${OWNER_DIR%/}/.claude-config"
    mkdir -p "${KDIR}" "${CCDIR}" 2>/dev/null || true
    chown -R user:user "${KDIR}" "${CCDIR}" 2>/dev/null || true
    export DATABASE_URL="sqlite+aiosqlite:///${KDIR}/kernel.db"
    # Persist the claude-agent-sdk conversation state (~/.claude → projects/*.jsonl
    # transcripts used by --resume) on COS, so a session can be resumed after the
    # sandbox is recreated. Without this the runtime session lives only in the
    # ephemeral container home and --resume fails with "No conversation found".
    export CLAUDE_CONFIG_DIR="${CCDIR}"
else
    export DATABASE_URL="sqlite+aiosqlite:////app/data/kernel.db"
fi

# Boot marker on COS (best-effort) so we can read the decision even if the kernel
# fails to start (e.g. SQLite-on-FUSE lock error).
if [ -n "${KDIR}" ]; then
    echo "boot $(date -u 2>/dev/null || true): DATABASE_URL=${DATABASE_URL} CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-}" >> "${KDIR}/boot.log" 2>/dev/null || true
    chown user:user "${KDIR}/boot.log" 2>/dev/null || true
fi

echo "[valuz-kernel] db=${DATABASE_URL} claude_cfg=${CLAUDE_CONFIG_DIR:-<default>} kdir=${KDIR:-/app/data(local)}"
s6-setuidgid user /app/.venv/bin/python -m alembic -c alembic/kernel/alembic.ini upgrade head

if [ -n "${KDIR}" ]; then
    exec s6-setuidgid user sh -c "exec /app/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port ${KERNEL_PORT:-8000} --log-level ${LOG_LEVEL:-info} >> '${KDIR}/serve.log' 2>&1"
else
    exec s6-setuidgid user /app/.venv/bin/python -m uvicorn app.main:app \
        --host 0.0.0.0 --port "${KERNEL_PORT:-8000}" --log-level "${LOG_LEVEL:-info}"
fi
