#!/command/with-contenv bash
# valuz-apply-env — apply per-user env to the sandbox, then start the gated kernel.
#
# Invoked by the host orchestrator OVER ENVD, after AGS snapshot-start, INSIDE the
# per-owner ensure lock (see valuz_commercial ... AgsSandboxBackend.apply_env).
# Snapshot-start can't inject per-user env at creation, so the host pipes the env
# to us here as newline-separated KEY=VALUE on stdin.
#
# We write each var into the s6 container-environment dir (so the kernel's
# `with-contenv` run script reads it) and then bring UP the kernel service — which
# ships GATED DOWN (sibling `down` file) so the snapshot never captured it running
# with the template's placeholder env. It therefore starts EXACTLY ONCE, with the
# correct per-user env (no wasted boot / double migration / restart gap). We block
# until /health is green so the host's lease is immediately usable.
set -eu

CONTENV="${S6_CONTAINER_ENVIRONMENT:-/run/s6/container_environment}"
KERNEL_SVC="/run/service/valuz-kernel"
KERNEL_PORT="${KERNEL_PORT:-8000}"
READY_TIMEOUT="${VALUZ_APPLY_ENV_READY_TIMEOUT:-90}"

mkdir -p "$CONTENV"

# Write each KEY=VALUE from stdin as an s6 contenv file (value may be empty). Keys
# are validated host-side too, but re-check here as defence in depth.
while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
        "" | [!A-Za-z_]* | *[!A-Za-z0-9_]*)
            echo "valuz-apply-env: rejecting bad env key '$key'" >&2
            exit 2
            ;;
    esac
    printf '%s' "$val" >"$CONTENV/$key"
done

s6svc="$(command -v s6-svc || echo /command/s6-svc)"
# Bring the gated kernel up (first + only start, now with the correct env).
"$s6svc" -u "$KERNEL_SVC"

# Block until the kernel is serving so the caller's lease is immediately usable.
deadline=$(($(date +%s) + READY_TIMEOUT))
until curl -fsS -o /dev/null "http://127.0.0.1:${KERNEL_PORT}/health" 2>/dev/null; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
        echo "valuz-apply-env: kernel not healthy within ${READY_TIMEOUT}s" >&2
        exit 1
    fi
    sleep 0.5
done
echo "valuz-apply-env: env applied; kernel up + healthy"
